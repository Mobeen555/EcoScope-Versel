# Server-side only. Never prefix these secrets with VITE_.
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TOKENS_PER_MINUTE=6000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-service-role-key
SUPABASE_BUCKET=ecoscope-private
APP_ACCESS_PASSWORD=choose-a-long-private-workspace-password
SESSION_SECRET=generate-at-least-32-random-characters
# Enable Large Functions in the Vercel project's environment settings too.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# LOCAL DEVELOPMENT ONLY: set ECOSCOPE_LOCAL=1 to use SQLite instead of Supabase.
ECOSCOPE_LOCAL=0
ECOSCOPE_DATA_DIR=.local-data
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
